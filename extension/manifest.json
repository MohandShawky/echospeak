{
  "manifest_version": 3,
  "name": "EchoSpeak Transcript Importer",
  "version": "0.3.1",
  "description": "Import a visible YouTube transcript into EchoSpeak for shadowing practice.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:5173/*",
    "http://localhost:5174/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:5174/*"
  ]
}
